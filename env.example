# Google Ads MCP Server Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# REQUIRED: Google Ads API Developer Token
# ============================================================================
# Get your developer token from: https://ads.google.com → Tools → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# ============================================================================
# OAUTH 2.0 CONFIGURATION - Choose ONE of the two options below
# ============================================================================

# ---------------------------------------------------------------------------
# OPTION 1: Use client_secret.json file (SIMPLEST - Recommended for beginners)
# ---------------------------------------------------------------------------
# 1. Download OAuth credentials from Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
# 2. Create "OAuth 2.0 Client ID" → Choose "Desktop application"
# 3. Download the JSON file (e.g., client_secret_123456.apps.googleusercontent.com.json)
# 4. Set the path below:
#
# GOOGLE_ADS_CREDENTIALS_PATH=/full/path/to/client_secret_xxxxx.apps.googleusercontent.com.json

# ---------------------------------------------------------------------------
# OPTION 2: Use environment variables (FLEXIBLE - For advanced users)
# ---------------------------------------------------------------------------
# If you prefer NOT to use a JSON file, you can extract the values manually:
# 1. Download the client_secret JSON file from Google Cloud Console (same as Option 1)
# 2. Open the file and copy the "client_id" and "client_secret" values
# 3. Set them here:
#
# GOOGLE_ADS_CLIENT_ID=123456789.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=GOCSPX-your_secret_here
# GOOGLE_ADS_CREDENTIALS_PATH=./google_ads_token.json
#
# Note: GOOGLE_ADS_CREDENTIALS_PATH specifies where to save your access tokens

# ============================================================================
# OPTIONAL: Manager Account Configuration
# ============================================================================
# Only needed if you're using a Manager (MCC) account to access sub-accounts
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# ============================================================================
# QUICK SETUP EXAMPLES
# ============================================================================
#
# Example 1: Using OPTION 1 (client_secret.json file)
# ---------------------------------------------------------------------------
# GOOGLE_ADS_DEVELOPER_TOKEN=ABcdEF12345678901234567890
# GOOGLE_ADS_CREDENTIALS_PATH=/Users/john/project/client_secret_123456.apps.googleusercontent.com.json
#
#
# Example 2: Using OPTION 2 (environment variables)
# ---------------------------------------------------------------------------
# GOOGLE_ADS_DEVELOPER_TOKEN=ABcdEF12345678901234567890
# GOOGLE_ADS_CLIENT_ID=123456789.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=GOCSPX-abc123def456
# GOOGLE_ADS_CREDENTIALS_PATH=./google_ads_token.json
#
# ============================================================================ 